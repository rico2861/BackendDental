# ═══════════════════════════════════════════════════════════════════════════
#  DENTAL — Backend SaaS  ·  renommez ce fichier en « .env »
#  Secrets déjà remplis (clé privée, JWT, mot de passe admin). Complétez MonCash,
#  Resend et Supabase. Ne committez jamais ce fichier.
# ═══════════════════════════════════════════════════════════════════════════

# ── Base de données ──────────────────────────────────────────────────────────
SAAS_DB_URL=                        # Supabase (prod). Vide = base locale PGlite (dev)
#  → Supabase : Settings → Database → Connection string (URI) :
#    postgresql://postgres:MOTDEPASSE@db.xxxx.supabase.co:5432/postgres
# SAAS_DB_DIR=./data                # dossier PGlite local (seulement si SAAS_DB_URL vide)

# ── Serveur & administrateur ─────────────────────────────────────────────────
SAAS_PORT=4000                      # port (si l'hébergeur impose PORT, il est prioritaire)
NODE_ENV=production
SAAS_JWT_SECRET=REMPLACER_PAR_UN_SECRET_32+_CARACTERES
SAAS_ADMIN_EMAIL=admin@votre-domaine.ht
SAAS_ADMIN_PASSWORD=CHANGEZ_MOI

# ── Licence (signature Ed25519) ──────────────────────────────────────────────
# Clé PRIVÉE (déjà la vôtre). Ne pas régénérer : la clé publique est dans l'app.
LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...VOTRE_CLE_PRIVEE_ED25519...\n-----END PRIVATE KEY-----"

# ── Paiement MonCash (Digicel) — vos clés MonCash Business ───────────────────
MONCASH_MODE=sandbox                # sandbox (test) ou live (production)
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_RETURN_URL=https://VOTRE-BACKEND/pay/retour
MONCASH_PAYOUT_ENABLED=false

# ── Tarifs (gourdes) ─────────────────────────────────────────────────────────
PRICE_1M=1500
PRICE_1Y=15000
PRICE_CURRENCY=HTG

# ── E-mails (Resend — https://resend.com → API Keys) ─────────────────────────
RESEND_API_KEY=
MAIL_FROM=support@votre-domaine.ht
MAIL_FROM_ADMIN=team@votre-domaine.ht
MAIL_SUPPORT=support@votre-domaine.ht

# ── Liens ────────────────────────────────────────────────────────────────────
VITRINE_URL=https://vitrine-chi-vert.vercel.app
DOWNLOAD_URL=https://github.com/rico2861/Dental/releases/latest

# ── Frontends hébergés séparément (vitrine + console) ────────────────────────
CORS_ORIGINS=https://vitrine-chi-vert.vercel.app   # URLs autorisées, séparées par virgule
SAAS_CROSS_SITE=true                # true si la console est sur un autre domaine
# STATIC_DIR=                       # servir un frontend statique depuis ce backend (optionnel)
