# ═══ DENTAL — Backend SaaS (.env) ═══════════════════════════════════════

# ── Base de données ──
# Postgres/Supabase en production. Vide = base locale PGlite (dossier ./data).
SAAS_DB_URL=

# ── Serveur & admin ──
SAAS_PORT=4000
NODE_ENV=production
SAAS_JWT_SECRET=remplacez_par_une_longue_chaine_aleatoire
# Compte admin créé au 1er démarrage
SAAS_ADMIN_EMAIL=admin@votre-domaine.ht
SAAS_ADMIN_PASSWORD=MotDePasseFort!2026

# ── Clé privée de signature des licences (Ed25519) ──
# NE JAMAIS committer. Collez ici le contenu de keys/license-private.pem
# (les retours à la ligne peuvent être remplacés par \n). Sans elle, impossible d'émettre des licences.
LICENSE_PRIVATE_KEY=

# ── MonCash (Digicel) ──
MONCASH_MODE=sandbox
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_RETURN_URL=https://votre-backend/pay/retour

# ── Tarifs (HTG) ──
PRICE_1M=1500
PRICE_1Y=15000
# PRICE_CURRENCY=HTG

# ── E-mails (Resend — API HTTPS, pas de SMTP) ──
RESEND_API_KEY=
MAIL_FROM=support@votre-domaine.ht
MAIL_FROM_ADMIN=team@votre-domaine.ht
MAIL_SUPPORT=support@votre-domaine.ht

# ── Liens ──
VITRINE_URL=https://votre-site-vitrine
DOWNLOAD_URL=https://github.com/rico2861/Dental/releases/latest

# ── Frontends hébergés séparément ──
# Origines autorisées (vitrine, console) séparées par des virgules
CORS_ORIGINS=
# true si la console est sur un autre domaine que ce backend (cookies cross-site)
SAAS_CROSS_SITE=false
# Servir un frontend statique depuis le backend (chemin), au lieu de web/
# STATIC_DIR=
